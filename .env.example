# 复制成 .env 再填。.env 已在 .gitignore 里，不要提交。

# ---------------------------------------------------------------
# 移动端（Expo）
#
# EXPO_PUBLIC_ 前缀的变量会被打进客户端包，所以这里只能放公开值。
# anon key 是设计上就要公开的——真正的访问控制在数据库的 RLS 策略上。
# ---------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Next.js API 的地址。真机调试时不能用 127.0.0.1，要填电脑在局域网里的 IP。
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# ---------------------------------------------------------------
# 服务端（Next.js）—— 以下任何一个都绝不能进移动端包
# ---------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude。AI_PROVIDER=mock 时不需要 key，全链路也能跑通（CI 用这个）。
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------
# OAuth（本地栈默认关闭这三家，见 supabase/config.toml）
# 拿到各平台凭据后填这里，并把 config.toml 里对应的 enabled 改成 true
# ---------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
